# LanXu StoreOS — example environment (copy to .env, never commit real .env)
# ---- API ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database (dev compose / embedded PG in tests) ----
DATABASE_URL=postgres://lanxu:lanxu_dev_password@localhost:5432/lanxu?application_name=lanxu-api

# ---- Redis (used from Edge/queue phases; optional until then) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Phase 02+) ----
# Minimum 32 chars. Production boot FAILS if unset or left at this dev value.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000000000
JWT_ACCESS_TTL_SECONDS=3600

# ---- Payments (EXTERNAL BLOCKER: real merchant credentials pending) ----
# Dev/test only: "fake". Production refuses to boot with fake.
PAYMENT_PROVIDER=fake
