{
  "name": "lanxu-storeos",
  "version": "0.1.0",
  "private": true,
  "description": "澜序 LanXu StoreOS — store operating system for foot-bath/SPA/massage stores",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b && npm run typecheck --workspace @lanxu/web",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -b && npm run build --workspace @lanxu/web",
    "openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi && git diff --exit-code -- docs/architecture/openapi.json",
    "migrate": "npm run migrate --workspace @lanxu/db --",
    "dev:api": "npm run dev --workspace @lanxu/api",
    "dev:web": "npm run dev --workspace @lanxu/web",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run openapi:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fastify": "5.12.7",
    "postcss": "^8.5.32"
  }
}
